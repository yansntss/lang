{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "popup",
  "description": "Permissões mínimas da janela do tradutor",
  "windows": ["popup"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-translate",
    "allow-copy-to-clipboard",
    "allow-explain",
    "allow-cancel-explain",
    "allow-has-secret",
    "allow-record-history",
    "allow-get-settings",
    "allow-hide-popup"
  ]
}
