{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "history",
  "description": "Permissões mínimas da janela de histórico",
  "windows": ["history"],
  "permissions": [
    "allow-list-history",
    "allow-delete-history",
    "allow-clear-history",
    "allow-toggle-favorite",
    "allow-export-history",
