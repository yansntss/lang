{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lang",
  "version": "0.1.0",
  "identifier": "com.yansa.lang-app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "popup",
        "title": "Lang",
        "url": "popup.html",
        "width": 420,
        "height": 200,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "maximizable": false,
        "minWidth": 320,
        "minHeight": 140,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; base-uri 'none'; form-action 'none'; object-src 'none'; frame-ancestors 'none'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420; base-uri 'none'; form-action 'none'; object-src 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "yansntss",
    "copyright": "Copyright © 2026 yansntss",
    "category": "Utility",
    "shortDescription": "Tradutor por atalho (inglês e português)",
    "longDescription": "Aperte um atalho global, e uma caixa perto do cursor traduz o texto selecionado entre inglês e português usando o DeepL, com explicação opcional pelo Claude.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR"],
        "displayLanguageSelector": false
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVBMTM4MTY1NEQ4OUE0NUMKUldSY3BJbE5aWUVUV3QwdTZ2M2VCSXNxeWdSY2RXbXN6Ymx4SmEyUUZiMm9EZVYvK1ZwZWhZQmkK",
      "endpoints": ["https://github.com/yansntss/lang/releases/latest/download/latest.json"],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
